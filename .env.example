# Konektado environment example
# Copy this file to .env or .env.local for local development.
# Do not commit real secrets.

# Expo client config
# These are bundled into the app, so only use values that are safe to expose.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-supabase-anon-public-key

# Optional internal demo editor access allowlist
# These are also public Expo variables. Use only non-secret identifiers.
EXPO_PUBLIC_INTERNAL_DEMO_EDITOR_EMAILS=admin@konektado.test
EXPO_PUBLIC_INTERNAL_DEMO_EDITOR_USER_IDS=

# Local maintenance/test scripts
# Prefer the service role key for admin-only scripts. Never expose it in client code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
VERIFICATION_EMAIL_BASE_URL=https://your-project-ref.supabase.co

# Supabase Edge Functions
# Set these in Supabase function secrets or your local function environment.
PROJECT_URL=https://your-project-ref.supabase.co
SERVICE_ROLE_KEY=your-supabase-service-role-key

# verification-email function
VERIFICATION_EMAIL_SITE_URL=https://konektado.app
VERIFICATION_EMAIL_CTA_URL=konektado://verification
VERIFICATION_EMAIL_PRIVACY_URL=https://konektado.app/privacy
VERIFICATION_EMAIL_TERMS_URL=https://konektado.app/terms
VERIFICATION_EMAIL_HELP_URL=https://konektado.app/help
VERIFICATION_EMAIL_UNSUBSCRIBE_URL=https://konektado.app
VERIFICATION_EMAIL_INSTAGRAM_URL=https://konektado.app
VERIFICATION_EMAIL_FACEBOOK_URL=https://konektado.app

# Optional email delivery provider for verification-email
# Use either Resend or SMTP. Leave blank for local/no-provider checks.
VERIFICATION_EMAIL_RESEND_API_KEY=
VERIFICATION_EMAIL_FROM_EMAIL=no-reply@konektado.app
VERIFICATION_EMAIL_FROM_NAME=Konektado
VERIFICATION_EMAIL_WEBHOOK_URL=
VERIFICATION_EMAIL_WEBHOOK_SECRET=
VERIFICATION_EMAIL_SMTP_HOST=
VERIFICATION_EMAIL_SMTP_PORT=587
VERIFICATION_EMAIL_SMTP_USER=
VERIFICATION_EMAIL_SMTP_PASS=
